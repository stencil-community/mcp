{
  "name": "@stencil-community/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server that gives AI coding agents accurate, version-aware knowledge of a StencilJS project.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stencil-community/mcp.git"
  },
  "homepage": "https://github.com/stencil-community/mcp#readme",
  "bugs": {
    "url": "https://github.com/stencil-community/mcp/issues"
  },
  "bin": {
    "stencil-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node test/smoke.mjs",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.6",
    "semantic-release": "^26.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
