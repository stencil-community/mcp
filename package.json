{
  "name": "@stencil-community/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server that gives AI coding agents accurate, version-aware knowledge of a StencilJS project.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stencil-community/mcp.git"
  },
  "homepage": "https://github.com/stencil-community/mcp#readme",
  "bugs": {
    "url": "https://github.com/stencil-community/mcp/issues"
  },
  "bin": {
    "stencil-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
